# ── App ──────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development

# ── Supabase ─────────────────────────────────────────
# Project Settings → API in your Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-side only, NEVER expose to the client bundle
SUPABASE_SERVICE_ROLE_KEY=

# ── Certificate signing (server-only) ───────────────
# Generate with: openssl rand -hex 32
CERTIFICATE_SIGNING_SECRET=

# ── Upstash Redis (rate limiting) ───────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Altcha (bot protection) ──────────────────────────
# Generate with: openssl rand -hex 32
ALTCHA_HMAC_SECRET=

# ── Resend (transactional email) ────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL="Certified <no-reply@yourdomain.com>"
# Where the public /contact form's messages land — there's no staff inbox
# table yet (docs/sitemap.md §7's /staff/support is still unbuilt), so this
# goes straight to a real inbox in the meantime. Falls back to a placeholder
# address if unset (fine locally, since email sends are mocked outside
# production anyway — lib/email/send.ts).
SUPPORT_INBOX_EMAIL=

# ── Admin bootstrap ──────────────────────────────────
# One-time invite code used to create the first Super Admin account
ADMIN_BOOTSTRAP_SECRET=

# ── Payments: certificate credits (Phase 11, Flow A) ─
# All server-only — never returned in any API response, never logged
# (CLAUDE.md rule #3's "signing key never touches the client" applies
# equally here, now also rule #12). Use TEST/sandbox-mode keys for all
# local development and routine testing; only switch to live keys for a
# deliberate, explicitly-approved real-money test (CLAUDE.md's free-tier
# discipline).
PAYSTACK_SECRET_KEY=
# No separate Paystack webhook secret — PAYSTACK_SECRET_KEY itself is used
# to verify the `x-paystack-signature` header (HMAC-SHA512 of the raw body).
# Not read by any server code today (only needed for Paystack's client-side
# inline.js widget, which this app doesn't use) — kept for completeness.
PAYSTACK_PUBLIC_KEY=

# Flutterwave is NOT currently wired in — lib/payments/flutterwave.ts was
# built against v3's simple secret-key + hosted-checkout-link model,
# but v3 and v4 are incompatible: v4 uses OAuth2 client-credentials
# (client_id/client_secret) and, as of 2026-09, has no hosted-checkout/
# payment-link endpoint — real charges require building a raw card-entry
# UI, encrypting card fields client-side (AES-256-GCM with the encryption
# key below), and orchestrating the charge directly, a materially bigger
# scope than a key swap. See docs/session-handoff.md §20 for the decision
# this is pending. These three are what a v4 integration would need:
FLUTTERWAVE_CLIENT_ID=
FLUTTERWAVE_CLIENT_SECRET=
FLUTTERWAVE_ENCRYPTION_KEY=

# ── Bulk issuance Cron (Phase 7) ─────────────────────
# Generate with: openssl rand -hex 32. Set the same value on the Vercel
# project's env vars — Vercel then automatically sends it as
# `Authorization: Bearer <value>` on its own Cron invocations (vercel.json),
# which is what app/api/cron/process-bulk-issuance checks against. Leaving
# this blank disables the auth check entirely (fine for local dev, never
# for production).
CRON_SECRET=
